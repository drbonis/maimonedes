# Copy to `.env` and edit. Values shown are project defaults.

# SQLite database file used for probe runs, scores, and recorded LLM calls.
# Keep the file OFF VirtualBox shared folders — vboxsf doesn't honour
# SQLite's locking + fsync, and `maimonedes perturb` / `calibrate`
# corrupt the DB mid-run. The path below is the dev-laptop ext4 default;
# adjust for your machine if it differs.
DATABASE_URL=sqlite:////home/vagrant/maimonedes.db

# Ollama (OpenAI-compatible /v1) endpoint serving the supervised + judge models.
# In v1 this is the GPU laptop on the LAN; see docs/roadmap.md for topology.
OLLAMA_BASE_URL=http://192.168.1.30:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_REQUEST_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=3

# Tags loaded into Ollama; `maimonedes ping --all` exercises both.
OLLAMA_SUPERVISED_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_JUDGE_MODEL=medgemma1.5:4b-it-q4_K_M
